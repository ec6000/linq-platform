rules_version = '2';

// LiNQ Firestore Security Rules
//
// The client is never trusted. Every write that matters is tied to the
// documents it claims to come from: a job can only exist if its order or
// booking points back at it in the same transaction, an order's offer count
// can only move together with an offer, and a booking copies its service
// instead of inventing a price or a provider.
//
// tests/rules.test.ts runs these rules against the emulator: `pnpm test:rules`.
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function data() { return request.resource.data; }

    function path(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }
    function offerPath(orderId, providerId) {
      return /databases/$(database)/documents/orders/$(orderId)/offers/$(providerId);
    }

    function role() { return get(path('users', uid())).data.role; }
    function isProvider() { return signedIn() && role() == 'provider'; }
    function isCustomer() { return signedIn() && role() == 'customer'; }

    /** True when an update touches no fields beyond the allowed list. */
    function onlyChanges(fields) { return data().diff(resource.data).affectedKeys().hasOnly(fields); }

    function cents(value) { return value is int && value >= 0 && value <= 100000000; }
    function price(value) { return cents(value) && value > 0; }
    function text(value, max) { return value is string && value.size() <= max; }

    // ── users ────────────────────────────────────────────────────────────────
    // A profile is private. What the other side of a job needs (name, e-mail,
    // phone) is copied into the offer, booking or job at the moment it is given.

    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId && data().role in ['provider', 'customer'];
      // The role is chosen once, at sign-up.
      allow update: if signedIn() && uid() == userId && data().role == resource.data.role;
      allow delete: if false;
    }

    // ── categories ───────────────────────────────────────────────────────────
    // Maintained by the seed script through the Admin SDK, which bypasses rules.

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // ── services ─────────────────────────────────────────────────────────────

    match /services/{serviceId} {
      function validService() {
        return text(data().title, 120) && text(data().description, 4000)
          && cents(data().minPriceInCent) && cents(data().maxPriceInCent)
          && data().maxPriceInCent >= data().minPriceInCent;
      }

      allow read: if true;
      allow create: if isProvider() && data().providerId == uid()
                    && data().status in ['active', 'paused'] && validService();
      // Archived is final: bookings and jobs keep pointing at the snapshot.
      allow update: if signedIn() && resource.data.providerId == uid()
                    && data().providerId == uid()
                    && resource.data.status != 'archived'
                    && data().status in ['active', 'paused', 'archived'] && validService();
      allow delete: if false;
    }

    // ── orders ───────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      function order() { return resource.data; }
      function owner() { return signedIn() && order().customerId == uid(); }

      function edits() {
        return data().status == 'open' && price(data().budgetInCent)
          && text(data().title, 120) && text(data().description, 4000)
          && onlyChanges(['title', 'description', 'budgetInCent', 'place', 'timeWindow', 'categoryId',
                          'categoryName', 'subcategoryId', 'subcategoryName', 'updatedAt']);
      }

      function cancels() {
        return data().status == 'cancelled' && onlyChanges(['status', 'cancelledAt', 'updatedAt']);
      }

      // Declining an offer closes it, so the count drops by one.
      function declines() {
        return onlyChanges(['offerCount', 'updatedAt'])
          && data().offerCount == order().offerCount - 1 && data().offerCount >= 0;
      }

      // The winning offer, the job and the order agree in one transaction.
      function accepts() {
        return data().status == 'assigned'
          && onlyChanges(['status', 'assignedProviderId', 'assignedProviderName', 'jobId', 'assignedAt',
                          'offerCount', 'updatedAt'])
          && data().offerCount == 0
          && getAfter(offerPath(orderId, data().assignedProviderId)).data.status == 'accepted'
          && getAfter(path('jobs', data().jobId)).data.sourceId == orderId;
      }

      // A provider's count change must match their own offer appearing or vanishing.
      function countsOwnOffer() {
        return isProvider() && order().status == 'open' && onlyChanges(['offerCount', 'updatedAt'])
          && ((data().offerCount == order().offerCount + 1
               && !exists(offerPath(orderId, uid())) && existsAfter(offerPath(orderId, uid())))
           || (data().offerCount == order().offerCount - 1
               && exists(offerPath(orderId, uid())) && !existsAfter(offerPath(orderId, uid()))));
      }

      // Once assigned, the order follows its job's status.
      function followsJob() {
        return 'jobId' in order()
          && (order().customerId == uid() || order().assignedProviderId == uid())
          && onlyChanges(['status', 'startedAt', 'completedAt', 'cancelledAt', 'updatedAt'])
          && data().status == getAfter(path('jobs', order().jobId)).data.status;
      }

      // Providers browse the job board. The exact address is not in here.
      allow read: if signedIn();

      allow create: if isCustomer()
                    && data().customerId == uid()
                    && data().status == 'open'
                    && data().offerCount == 0
                    && price(data().budgetInCent)
                    && text(data().title, 120) && text(data().description, 4000)
                    && !('jobId' in data()) && !('assignedProviderId' in data());

      allow update: if signedIn() && (
        (owner() && order().status == 'open' && (edits() || cancels() || declines() || accepts()))
        || countsOwnOffer()
        || followsJob()
      );

      allow delete: if false;

      // ── the exact address: the customer's, and the job's once agreed ───────

      match /private/{docId} {
        allow read: if signedIn() && get(path('orders', orderId)).data.customerId == uid();
        allow write: if signedIn() && docId == 'address'
                     && getAfter(path('orders', orderId)).data.customerId == uid()
                     && getAfter(path('orders', orderId)).data.status == 'open';
      }

      // ── offers ─────────────────────────────────────────────────────────────
      // The document ID is the provider's UID, so one provider can hold at most
      // one offer per order no matter how often the button is pressed.

      match /offers/{providerId} {
        function parent() { return get(path('orders', orderId)).data; }

        allow read: if signedIn() && (uid() == providerId || parent().customerId == uid());

        allow create: if isProvider()
                      && uid() == providerId
                      && data().providerId == uid()
                      && data().orderId == orderId
                      && data().status == 'pending'
                      && price(data().priceInCent)
                      && text(data().message, 500)
                      && parent().status == 'open'
                      && getAfter(path('orders', orderId)).data.offerCount == parent().offerCount + 1;

        // Only the customer decides, and only the decision changes.
        allow update: if signedIn()
                      && parent().customerId == uid()
                      && resource.data.status == 'pending'
                      && data().status in ['accepted', 'declined']
                      && onlyChanges(['status', 'decidedAt', 'updatedAt']);

        // Withdrawing is the provider deleting their own pending offer while bidding is open.
        allow delete: if signedIn()
                      && uid() == providerId
                      && resource.data.status == 'pending'
                      && parent().status == 'open';
      }
    }

    // A provider's own offers across all orders (collection-group query).
    match /{prefix=**}/offers/{providerId} {
      allow read: if signedIn() && resource.data.providerId == uid();
    }

    // ── bookings ─────────────────────────────────────────────────────────────

    match /bookings/{bookingId} {
      function booking() { return resource.data; }
      function involved() { return booking().customerId == uid() || booking().providerId == uid(); }

      // Everything the provider will rely on is copied from the live service.
      function matchesService() {
        let source = get(path('services', data().serviceId)).data;
        return source.status == 'active'
          && data().providerId == source.providerId
          && data().serviceTitle == source.title
          && data().pricing == source.pricing;
      }

      allow read: if signedIn() && involved();

      allow create: if isCustomer()
                    && data().customerId == uid()
                    && data().providerId != uid()
                    && data().status == 'requested'
                    && text(data().message, 2000)
                    && (!('priceInCent' in data()) || price(data().priceInCent))
                    && !('jobId' in data())
                    && matchesService();

      allow update: if signedIn() && booking().status == 'requested' && (
        // The provider declines…
        (booking().providerId == uid() && data().status == 'declined'
         && onlyChanges(['status', 'declineMessage', 'declinedAt', 'updatedAt']))
        // …or names the final price and creates the job in the same transaction.
        || (booking().providerId == uid() && data().status == 'accepted'
            && onlyChanges(['status', 'priceInCent', 'jobId', 'acceptedAt', 'updatedAt'])
            && price(data().priceInCent)
            && getAfter(path('jobs', data().jobId)).data.sourceId == bookingId)
        // The customer withdraws a request nobody has answered yet.
        || (booking().customerId == uid() && data().status == 'cancelled'
            && onlyChanges(['status', 'cancelledAt', 'updatedAt']))
      );

      allow delete: if false;
    }

    // ── jobs ─────────────────────────────────────────────────────────────────
    // Created only inside the two accept transactions, and only when the order
    // or booking they come from points back at them.

    match /jobs/{jobId} {
      function job() { return resource.data; }

      function fromOrder() {
        let order = getAfter(path('orders', data().sourceId)).data;
        return data().sourceType == 'order'
          && data().customerId == uid()
          && order.customerId == uid()
          && order.jobId == jobId
          && order.assignedProviderId == data().providerId
          && data().priceInCent == get(offerPath(data().sourceId, data().providerId)).data.priceInCent;
      }

      function fromBooking() {
        let booking = getAfter(path('bookings', data().sourceId)).data;
        return data().sourceType == 'booking'
          && data().providerId == uid()
          && booking.providerId == uid()
          && booking.customerId == data().customerId
          && booking.jobId == jobId
          && booking.priceInCent == data().priceInCent;
      }

      // The same table as lib/utils/jobStatus.ts.
      function step(from, to) {
        return (from == 'scheduled' && to in ['inProgress', 'cancelled'])
          || (from == 'inProgress' && to in ['completed', 'cancelled']);
      }

      allow read: if signedIn() && (job().customerId == uid() || job().providerId == uid());

      allow create: if signedIn()
                    && data().status == 'scheduled'
                    && data().customerId != data().providerId
                    && price(data().priceInCent)
                    && (fromOrder() || fromBooking());

      // The provider drives the job; the customer may only call it off before it starts.
      allow update: if signedIn()
                    && onlyChanges(['status', 'startedAt', 'completedAt', 'cancelledAt', 'updatedAt'])
                    && step(job().status, data().status)
                    && (job().providerId == uid()
                        || (job().customerId == uid() && job().status == 'scheduled' && data().status == 'cancelled'));

      allow delete: if false;
    }
  }
}
