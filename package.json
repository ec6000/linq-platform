{
  "name": "linq-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:rules": "pnpm dlx firebase-tools@14 emulators:exec --only firestore --project demo-linq \"node scripts/test.mjs\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/resetDb.ts",
    "db:claim": "tsx scripts/claimSeedData.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10 <11"
  }
}
